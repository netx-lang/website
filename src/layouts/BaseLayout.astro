---
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/ui";
import { localeUrl } from "../lib/i18n-url";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import HeadFonts from "../components/HeadFonts.astro";
import "../styles/landing.css";
import "../styles/lang-menu.css";
import { withBase } from "../lib/base";
import { ENABLE_I18N } from "../lib/features";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const title = t("meta.title");
const description = t("meta.description");
const path = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang={lang === "zh" ? "zh-CN" : "en"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f2b46" />
    <HeadFonts />
    <link rel="icon" type="image/svg+xml" href={withBase("/assets/logo-mark.svg?v=4")} />
    {ENABLE_I18N && (
      <>
        <link rel="alternate" hreflang="en" href={localeUrl(path, "en")} />
        <link rel="alternate" hreflang="zh" href={localeUrl(path, "zh")} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={withBase("/assets/logo.svg?v=4")} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t("skip")}</a>
    <SiteHeader lang={lang} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter lang={lang} />
    <script>import "../scripts/main.js";</script>
  </body>
</html>
