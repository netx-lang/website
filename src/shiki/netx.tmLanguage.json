{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "netx",
  "displayName": "NetX",
  "scopeName": "source.nx",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#blocks"
    },
    {
      "include": "#arrays"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.netx",
          "match": "//.*$"
        },
        {
          "name": "comment.block.netx",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.netx",
          "match": "\\b(if|then|else|for|when|in)\\b"
        },
        {
          "name": "keyword.declaration.netx",
          "match": "\\b(application|library|import|as|component|interface|enum|wire|bundle|auto|let|of|default)\\b"
        },
        {
          "name": "keyword.operator.logical.netx",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.netx",
          "match": "\\b(wire|bundle|auto|clock)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.netx",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.netx",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.bitvector.binary.netx",
          "match": "\\b[0-9][0-9_]*'[bB][01][01_]*\\b"
        },
        {
          "name": "constant.numeric.bitvector.hex.netx",
          "match": "\\b[0-9][0-9_]*'[hH][0-9a-fA-F][0-9a-fA-F_]*\\b"
        },
        {
          "name": "constant.numeric.bitvector.octal.netx",
          "match": "\\b[0-9][0-9_]*'[oO][0-7][0-7_]*\\b"
        },
        {
          "name": "constant.numeric.bitvector.decimal.netx",
          "match": "\\b[0-9][0-9_]*'[dD][0-9][0-9_]*\\b"
        },
        {
          "name": "constant.numeric.float.netx",
          "match": "\\b[0-9][0-9_]*'[fF][0-9][0-9_]*(\\.[0-9][0-9_]*)?\\b"
        },
        {
          "name": "constant.numeric.integer.netx",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.netx",
          "match": "="
        },
        {
          "name": "keyword.operator.comparison.netx",
          "match": "==|!=|<=?\\*?|>=?\\*?|<\\*|>\\*"
        },
        {
          "name": "keyword.operator.bitwise.netx",
          "match": "&|\\||\\^|~|\\^~|~\\^|<<<?|>>>?"
        },
        {
          "name": "keyword.operator.arithmetic.netx",
          "match": "\\+|-|\\*\\*?|/|%"
        },
        {
          "name": "keyword.operator.range.netx",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.concatenation.netx",
          "match": "\\+\\+|<>|\\|\\|"
        },
        {
          "name": "keyword.operator.arrow.netx",
          "match": "->"
        },
        {
          "name": "keyword.operator.access.netx",
          "match": "\\.|#"
        },
        {
          "name": "keyword.operator.other.netx",
          "match": ":"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.netx",
          "match": "\\b(REGISTER|ASYNC_REGISTER|SPLIT|DUP|TO|UCAST|CAST|CONCAT|OR|NOT|AND|XOR|NOR|NAND|XNOR|EQ|NE|SLT|SLE|SGT|SGE|ULT|ULE|UGT|UGE|ADD|SUB|SHL|MUL|DIV|MOD|ASHR|LSHR)\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.netx",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.netx",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.other.netx",
          "match": "\\b[A-Z][A-Z0-9_]*\\b"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.netx",
          "begin": "\\(",
          "end": "\\)",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#keywords"
            },
            {
              "include": "#types"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#builtins"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#variables"
            },
            {
              "name": "punctuation.separator.netx",
              "match": ","
            }
          ]
        }
      ]
    },
    "blocks": {
      "patterns": [
        {
          "name": "meta.block.netx",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#keywords"
            },
            {
              "include": "#types"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#builtins"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#variables"
            },
            {
              "include": "#attributes"
            },
            {
              "include": "#blocks"
            },
            {
              "include": "#arrays"
            }
          ]
        }
      ]
    },
    "arrays": {
      "patterns": [
        {
          "name": "meta.array.netx",
          "begin": "\\[",
          "end": "\\]",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#keywords"
            },
            {
              "include": "#types"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#builtins"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#variables"
            },
            {
              "include": "#attributes"
            },
            {
              "include": "#blocks"
            },
            {
              "include": "#arrays"
            },
            {
              "name": "punctuation.separator.netx",
              "match": ","
            }
          ]
        }
      ]
    }
  }
}
